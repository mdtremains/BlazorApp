    private decimal TryGetDecimalFromRow(DataRow row, int colIndex)
    {
        if (colIndex >= 0 && colIndex < row.Table.Columns.Count)
        {
            var raw = row[colIndex];
            if (raw == null || raw == DBNull.Value) return 0m;
            if (raw is double d) return (decimal)d;
            if (raw is float f) return (decimal)f;
            if (decimal.TryParse(raw.ToString(), out var dec)) return dec;
            var s = System.Text.RegularExpressions.Regex.Replace(raw.ToString(), @"[^\d\.\-]", "");
            if (decimal.TryParse(s, out var dec2)) return dec2;
        }
        return 0m;
    }
