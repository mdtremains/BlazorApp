@page "/pie-charts"
@using Models
@using System.Data
@using Shared
@* @using ExcelDataReader *@
@inject IWebHostEnvironment Env
@rendermode InteractiveServer

<h3>Monthly Debits / Credits Pie Charts</h3>

<!-- Use InputFile component instead of plain <input type="file"> -->
@* <InputFile OnChange="OnInputFileChangeInputFile" accept=".xlsx,.xls,.csv" /> *@

<button class="btn btn-primary" @onclick="LoadTestData">LoadTestData</button>

@if (items is null || items.Count == 0)
{
    <p>No data loaded. Upload an Excel (.xlsx/.xls) with columns containing 'Debit' and 'Credit' (and a label column like 'Month').</p>
}
else
{
    <div>
        @foreach (var m in items)
        {
            <MonthlyDebitCreditPie Debits="@m.Debits"
                                          Credits="@m.Credits"
                                          Label="@m.Label"
                                          Size="140" />
        }
    </div>
}

